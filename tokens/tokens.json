{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Saleba — design tokens uniques pour toutes les plateformes (Pro, Market, TV, back-office, web). Source de vérité : ne jamais coder une couleur ailleurs.",
  "color": {
    "brand": {
      "primary":        { "$type": "color", "$value": "#0B6E5A", "$description": "Vert Saleba — prospérité, confiance" },
      "primary-strong": { "$type": "color", "$value": "#07513F" },
      "primary-soft":   { "$type": "color", "$value": "#E6F4EF" },
      "accent":         { "$type": "color", "$value": "#F2A93B", "$description": "Safran — le marché, l'énergie, l'action" },
      "accent-strong":  { "$type": "color", "$value": "#D98A14" },
      "accent-soft":    { "$type": "color", "$value": "#FDF1DC" },
      "terracotta":     { "$type": "color", "$value": "#C2410C", "$description": "Couleur d'appoint (promotions, mise en avant)" }
    },
    "neutral": {
      "0":   { "$type": "color", "$value": "#FFFFFF" },
      "25":  { "$type": "color", "$value": "#FBF8F3" },
      "50":  { "$type": "color", "$value": "#F5F2EC" },
      "100": { "$type": "color", "$value": "#E7E2DA" },
      "300": { "$type": "color", "$value": "#C9C2B8" },
      "400": { "$type": "color", "$value": "#A8A29E" },
      "600": { "$type": "color", "$value": "#57534E" },
      "800": { "$type": "color", "$value": "#292524" },
      "900": { "$type": "color", "$value": "#1C1917" },
      "950": { "$type": "color", "$value": "#121110" }
    },
    "feedback": {
      "success": { "$type": "color", "$value": "#15803D" },
      "warning": { "$type": "color", "$value": "#B45309" },
      "danger":  { "$type": "color", "$value": "#B42318" },
      "info":    { "$type": "color", "$value": "#1D4ED8" },
      "success-soft": { "$type": "color", "$value": "#EAF6EE", "$description": "Fond des messages et badges de succès" },
      "warning-soft": { "$type": "color", "$value": "#FDF3E7" },
      "danger-soft":  { "$type": "color", "$value": "#FCEDEC" },
      "info-soft":    { "$type": "color", "$value": "#EAF0FC" }
    },
    "overlay": {
      "$description": "Textes et voiles translucides sur fond sombre (écrans TV, scanner, verrou) ; #RRGGBBAA",
      "on-dark-high":   { "$type": "color", "$value": "#FFFFFFB3" },
      "on-dark-medium": { "$type": "color", "$value": "#FFFFFF8A" },
      "on-dark-low":    { "$type": "color", "$value": "#FFFFFF61" },
      "on-dark-faint":  { "$type": "color", "$value": "#FFFFFF4D" },
      "on-dark-subtle": { "$type": "color", "$value": "#FFFFFF1F" },
      "scrim":          { "$type": "color", "$value": "#1C19178A" }
    },
    "data": {
      "$description": "Palette catégorielle des graphiques KPI (ordre fixe)",
      "1": { "$type": "color", "$value": "#0B6E5A" },
      "2": { "$type": "color", "$value": "#F2A93B" },
      "3": { "$type": "color", "$value": "#1D4ED8" },
      "4": { "$type": "color", "$value": "#C2410C" },
      "5": { "$type": "color", "$value": "#7C3AED" },
      "6": { "$type": "color", "$value": "#0891B2" }
    }
  },
  "semantic": {
    "light": {
      "bg":          { "$type": "color", "$value": "{color.neutral.25}" },
      "surface":     { "$type": "color", "$value": "{color.neutral.0}" },
      "surface-alt": { "$type": "color", "$value": "{color.neutral.50}" },
      "border":      { "$type": "color", "$value": "{color.neutral.100}" },
      "text":        { "$type": "color", "$value": "{color.neutral.900}" },
      "text-muted":  { "$type": "color", "$value": "{color.neutral.600}" },
      "primary":     { "$type": "color", "$value": "{color.brand.primary}" },
      "on-primary":  { "$type": "color", "$value": "{color.neutral.0}" },
      "accent":      { "$type": "color", "$value": "{color.brand.accent}" },
      "on-accent":   { "$type": "color", "$value": "{color.neutral.900}" }
    },
    "dark": {
      "bg":          { "$type": "color", "$value": "{color.neutral.950}" },
      "surface":     { "$type": "color", "$value": "#1A1816" },
      "surface-alt": { "$type": "color", "$value": "{color.neutral.800}" },
      "border":      { "$type": "color", "$value": "#34302C" },
      "text":        { "$type": "color", "$value": "{color.neutral.100}" },
      "text-muted":  { "$type": "color", "$value": "{color.neutral.400}" },
      "primary":     { "$type": "color", "$value": "#3FD1A8" },
      "on-primary":  { "$type": "color", "$value": "{color.neutral.950}" },
      "accent":      { "$type": "color", "$value": "#F5B651" },
      "on-accent":   { "$type": "color", "$value": "{color.neutral.950}" }
    }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["Plus Jakarta Sans", "Noto Sans", "sans-serif"] },
      "body":    { "$type": "fontFamily", "$value": ["Inter", "Noto Sans", "sans-serif"] },
      "mono":    { "$type": "fontFamily", "$value": ["JetBrains Mono", "monospace"] }
    },
    "size": {
      "xs": { "$type": "dimension", "$value": "12px" },
      "sm": { "$type": "dimension", "$value": "14px" },
      "md": { "$type": "dimension", "$value": "16px" },
      "lg": { "$type": "dimension", "$value": "18px" },
      "xl": { "$type": "dimension", "$value": "22px" },
      "2xl": { "$type": "dimension", "$value": "28px" },
      "3xl": { "$type": "dimension", "$value": "36px" },
      "tv":  { "$type": "dimension", "$value": "48px", "$description": "Écran TV, lisible à 3 m" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium":  { "$type": "fontWeight", "$value": 500 },
      "semibold":{ "$type": "fontWeight", "$value": 600 },
      "bold":    { "$type": "fontWeight", "$value": 700 }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "12": { "$type": "dimension", "$value": "48px" }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "12px" },
    "lg": { "$type": "dimension", "$value": "16px" },
    "xl": { "$type": "dimension", "$value": "24px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  },
  "shadow": {
    "sm": { "$type": "shadow", "$value": { "color": "#1C191714", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" } },
    "md": { "$type": "shadow", "$value": { "color": "#1C19171F", "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "0px" } }
  },
  "motion": {
    "fast":   { "$type": "duration", "$value": "120ms" },
    "normal": { "$type": "duration", "$value": "200ms" },
    "slow":   { "$type": "duration", "$value": "320ms" },
    "ease":   { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
  },
  "size": {
    "touch-min": { "$type": "dimension", "$value": "48px", "$description": "Cible tactile minimale" },
    "pos-key":   { "$type": "dimension", "$value": "72px", "$description": "Touche de caisse" }
  }
}
